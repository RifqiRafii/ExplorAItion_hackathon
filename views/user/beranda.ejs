</div>
</div>
<!-- MODAL 2: Draf Pesan WhatsApp Ramah Copilot AI -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="modalWaDraft">
<div class="bg-surface-container-lowest w-full max-w-md rounded-2xl shadow-2xl overflow-hidden flex flex-col">
<div class="p-space-md bg-tertiary text-on-tertiary flex items-center justify-between">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-2xl">chat</span>
<h3 class="font-headline-sm text-headline-sm font-bold">Draf Pengingat Bon Santun</h3>
</div>
<button class="w-8 h-8 rounded-full bg-on-tertiary/20 flex items-center justify-center text-on-tertiary" onclick="closeWaModal()">
<span class="material-symbols-outlined text-base">close</span>
</button>
</div>
<div class="p-space-lg space-y-3">
<div class="flex items-center justify-between text-on-surface-variant font-label-sm text-label-sm">
<span>Penerima: <strong>Bu Siti (0812-9876-XXXX)</strong></span>
<span class="text-tertiary font-bold">Total: Rp 175.000</span>
</div>
<div class="p-space-md rounded-xl bg-surface-container-low font-body-md text-body-md text-on-surface leading-relaxed">
          "Assalamu’alaikum Bu Siti, semoga sehat selalu ya sekeluarga 🙏 Maaf sekadar mengingatkan catatan belanjaan sembako tempo kemarin sebesar Rp 175.000 sudah jatuh tempo hari ini. Jika longgar bisa dititipkan ke warung atau lewat QRIS ya Bu. Matur nuwun sanget 😊 - Warung Berkah"
        </div>
<p class="font-body-sm text-body-sm text-on-surface-variant">
          Pesan ini dirancang AI dengan nada kekeluargaan agar hubungan pelanggan tetap hangat dan hutang terbayar tepat waktu.
        </p>
</div>
<div class="p-space-md bg-surface-container flex items-center justify-end gap-space-sm">
<button class="px-4 py-2.5 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md" onclick="closeWaModal()">
          Tutup
        </button>
<button class="px-5 py-2.5 rounded-xl bg-primary text-on-primary font-label-md text-label-md flex items-center gap-1.5 shadow-sm active:scale-95" onclick="sendWaMessage()">
<span class="material-symbols-outlined text-lg">send</span>
<span>Buka WhatsApp Sekarang</span>
</button>
</div>
</div>
</div>
<!-- QRIS Preview Modal -->
<div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-on-surface/40 backdrop-blur-sm hidden opacity-0 transition-opacity duration-200" id="modalQris">
<div class="bg-surface-container-lowest w-full max-w-xs rounded-2xl shadow-2xl p-space-lg text-center flex flex-col items-center">
<div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center mb-2">
<span class="material-symbols-outlined text-2xl">qr_code_2</span>
</div>
<h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">QRIS Warung Berkah</h3>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-0.5">NMID: ID1029384758930</p>
<div class="my-4 p-3 bg-surface-container rounded-xl">
<div class="w-48 h-48 bg-on-surface flex items-center justify-center rounded-lg text-surface-container-lowest p-2">
<!-- QR Dummy Icon representation -->
<span class="material-symbols-outlined text-8xl">qr_code</span>
</div>
</div>
<p class="font-label-sm text-label-sm text-primary font-bold">Menerima GoPay, OVO, Dana, BCA, Mandiri</p>
<button class="w-full mt-4 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors" onclick="closeQrisModal()">
        Tutup
      </button>
</div>
</div>
</div>
<script>
  let currentPayMode = 'tunai';

  function showToast(message) {
    const toast = document.getElementById('toastNotification');
    const toastMsg = document.getElementById('toastMsg');
    if (toast && toastMsg) {
      toastMsg.innerText = message;
      toast.classList.remove('translate-x-96', 'opacity-0');
      toast.classList.add('translate-x-0', 'opacity-100');
      setTimeout(() => {
        toast.classList.add('translate-x-96', 'opacity-0');
        toast.classList.remove('translate-x-0', 'opacity-100');
      }, 3500);
    }
  }

  function openTransactionModal() {
    const modal = document.getElementById('modalTransaksiKilat');
    modal.classList.remove('hidden');
    setTimeout(() => modal.classList.remove('opacity-0'), 10);
    document.getElementById('txItemName').focus();
  }

  function closeTransactionModal() {
    const modal = document.getElementById('modalTransaksiKilat');
    modal.classList.add('opacity-0');
    setTimeout(() => modal.classList.add('hidden'), 200);
    // Reset Form
    document.getElementById('txItemName').value = '';
    document.getElementById('txAmount').value = '';
    document.getElementById('txCustomerName').value = '';
    setPaymentType('tunai');
  }

  function selectQuickSku(name, price) {
    document.getElementById('txItemName').value = name;
    document.getElementById('txAmount').value = price;
  }

  function setPaymentType(type) {
    currentPayMode = type;
    const tunaiBtn = document.getElementById('payTunaiBtn');
    const kasbonBtn = document.getElementById('payKasbonBtn');
    const customerBox = document.getElementById('kasbonCustomerBox');

    if (type === 'tunai') {
      tunaiBtn.className = "py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-1.5 shadow-sm";
      kasbonBtn.className = "py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-1.5";
      customerBox.classList.add('hidden');
    } else {
      kasbonBtn.className = "py-2.5 rounded-lg bg-tertiary text-on-tertiary font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-1.5 shadow-sm";
      tunaiBtn.className = "py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-1.5";
      customerBox.classList.remove('hidden');
      document.getElementById('txCustomerName').focus();
    }
  }

  function saveInstantTransaction() {
    const itemName = document.getElementById('txItemName').value || 'Penjualan Sembako';
    const amountVal = document.getElementById('txAmount').value;
    const customer = document.getElementById('txCustomerName').value || 'Pelanggan Langganan';

    if (!amountVal || amountVal <= 0) {
      alert('Silakan masukkan nominal harga yang valid!');
      return;
    }

    const formattedAmount = new Intl.NumberFormat('id-ID').format(amountVal);
    const container = document.getElementById('transactionListContainer');

    const newTxRow = document.createElement('div');
    newTxRow.className = "p-space-sm rounded-xl bg-surface-container-low/70 hover:bg-surface-container-low transition-colors flex items-center justify-between gap-space-sm animate-fade-in";
    
    if (currentPayMode === 'tunai') {
      newTxRow.innerHTML = `
        <div class="flex items-center gap-space-sm min-w-0">
          <div class="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-xl">check</span>
          </div>
          <div class="min-w-0">
            <h4 class="font-label-md text-label-md text-on-surface font-bold truncate">${itemName}</h4>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="font-label-sm text-label-sm px-1.5 py-0.5 rounded bg-secondary-container/60 text-on-secondary-container">Tunai Lunas</span>
              <span class="font-body-sm text-body-sm text-primary font-medium">Kas Bertambah</span>
            </div>
          </div>
        </div>
        <div class="text-right shrink-0">
          <span class="font-headline-sm text-headline-sm font-bold text-primary">+Rp ${formattedAmount}</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant block mt-0.5">Baru saja</span>
        </div>
      `;
      showToast(`Sukses mencatat ${itemName} Rp ${formattedAmount} tunai!`);
    } else {
      newTxRow.innerHTML = `
        <div class="flex items-center gap-space-sm min-w-0">
          <div class="w-10 h-10 rounded-xl bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center shrink-0">
            <span class="material-symbols-outlined text-xl">edit_note</span>
          </div>
          <div class="min-w-0">
            <h4 class="font-label-md text-label-md text-on-surface font-bold truncate">${itemName}</h4>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="font-label-sm text-label-sm px-1.5 py-0.5 rounded bg-tertiary-fixed text-on-tertiary-fixed">Bon ${customer}</span>
              <span class="font-body-sm text-body-sm text-tertiary font-medium">Buku Utang Ditambahkan</span>
            </div>
          </div>
        </div>
        <div class="text-right shrink-0">
          <span class="font-headline-sm text-headline-sm font-bold text-tertiary">Rp ${formattedAmount}</span>
          <span class="font-body-sm text-body-sm text-on-surface-variant block mt-0.5">Baru saja</span>
        </div>
      `;
      showToast(`Sukses mencatat kasbon ${customer} Rp ${formattedAmount}!`);
    }

    if (container.firstChild) {
      container.insertBefore(newTxRow, container.firstChild);
    } else {
      container.appendChild(newTxRow);
    }

    closeTransactionModal();
  }

  function triggerVoiceInput() {
    const mic = document.getElementById('micIcon');
    mic.classList.add('animate-pulse', 'text-error');
    showToast('Mendengarkan suara Anda... "Katakan nama barang & nominal"');
    setTimeout(() => {
      mic.classList.remove('animate-pulse', 'text-error');
      openTransactionModal();
      document.getElementById('txItemName').value = 'Beras Ramos 5kg (2 Sak)';
      document.getElementById('txAmount').value = 150000;
      showToast('Copilot AI mengenali: "Beras Ramos 5kg, 150.000"');
    }, 1500);
  }

  function triggerOcrCamera() {
    showToast('Membuka kamera pemindai OCR Nota Sembako...');
    setTimeout(() => {
      showToast('Faktur Grosir Terdeteksi: Gula Pasir 1 Karung (Rp 750.000)');
    }, 1200);
  }

  function handleQuickPO() {
    showToast('Draf Pesan Grosir Minyak Kita dibuat otomatis via WA Distributor!');
  }

  function openWaDraftModal() {
    const modal = document.getElementById('modalWaDraft');
    modal.classList.remove('hidden');
    setTimeout(() => modal.classList.remove('opacity-0'), 10);
  }

  function closeWaModal() {
    const modal = document.getElementById('modalWaDraft');
    modal.classList.add('opacity-0');
    setTimeout(() => modal.classList.add('hidden'), 200);
  }

  function sendWaMessage() {
    window.open('https://wa.me/?text=' + encodeURIComponent('Assalamu’alaikum Bu Siti, semoga sehat selalu sekeluarga. Maaf sekadar mengingatkan catatan belanja tempo kemarin sebesar Rp 175.000 sudah jatuh tempo hari ini. Matur nuwun sanget - Warung Berkah'), '_blank');
    closeWaModal();
  }

  function showQrisCode() {
    const modal = document.getElementById('modalQris');
    modal.classList.remove('hidden');
    setTimeout(() => modal.classList.remove('opacity-0'), 10);
  }

  function closeQrisModal() {
    const modal = document.getElementById('modalQris');
    modal.classList.add('opacity-0');
    setTimeout(() => modal.classList.add('hidden'), 200);
  }

  function refreshData() {
    const icon = document.getElementById('refreshIcon');
    icon.classList.add('animate-spin');
    setTimeout(() => {
      icon.classList.remove('animate-spin');
      showToast('Data Kasir & Stok berhasil diperbarui realtime!');
    }, 800);
  }

  function openRestockModal() {
    showToast('Membuka modul restock otomatis sembako...');
  }

  function scrollToBonList() {
    showToast('Mengarahkan ke Buku Bon & Kasbon Pelanggan...');
  }

  function openFullHistory() {
    showToast('Membuka Riwayat Lengkap Arus Kas Warung...');
  }
</script></main></div></body></html>