<input class="w-full h-12 px-4 rounded-xl bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-highest transition-colors" id="txItemName" placeholder="Contoh: Beras Ramos 5kg / Gula Pasir" type="text"/>
</div>
<!-- Input Nominal Harga -->
<div>
<label class="font-label-md text-label-md text-on-surface block mb-1">Nominal Transaksi (Rp)</label>
<div class="relative">
<span class="absolute left-4 top-1/2 -translate-y-1/2 font-headline-sm text-headline-sm text-primary font-bold">Rp</span>
<input class="w-full h-12 pl-12 pr-4 rounded-xl bg-surface-container-low text-on-surface font-headline-sm text-headline-sm font-bold focus:outline-none focus:bg-surface-container-highest transition-colors" id="txAmount" placeholder="0" type="number"/>
</div>
</div>
<!-- Toggle Tipe Pembayaran: Tunai Lunas vs Kasbon / Piutang -->
<div>
<label class="font-label-md text-label-md text-on-surface block mb-1.5">Metode Bayar</label>
<div class="grid grid-cols-2 gap-space-xs p-1 bg-surface-container rounded-xl">
<button class="py-2.5 rounded-lg bg-primary text-on-primary font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-1.5 shadow-sm" id="payTunaiBtn" onclick="setPaymentType('tunai')" type="button">
<span class="material-symbols-outlined text-base">payments</span>
<span>Tunai / QRIS (Lunas)</span>
</button>
<button class="py-2.5 rounded-lg text-on-surface-variant hover:text-on-surface font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-1.5" id="payKasbonBtn" onclick="setPaymentType('kasbon')" type="button">
<span class="material-symbols-outlined text-base">menu_book</span>
<span>Kasbon / Piutang</span>
</button>
</div>
</div>
<!-- Input Nama Pelanggan (Muncul jika Kasbon) -->
<div class="hidden" id="kasbonCustomerBox">
<label class="font-label-md text-label-md text-tertiary block mb-1 font-bold">Nama Pelanggan (Buku Bon)</label>
<input class="w-full h-11 px-4 rounded-xl bg-tertiary-fixed/30 text-on-surface font-body-md text-body-md focus:outline-none focus:bg-tertiary-fixed/50 transition-colors" id="txCustomerName" placeholder="Contoh: Bu Siti / Mas Joko / Pak RT" type="text"/>
</div>
</div>
<!-- Action Button Simpan Instan -->
<div class="p-space-md bg-surface-container flex items-center justify-end gap-space-sm">
<button class="px-space-md py-3 rounded-xl bg-surface-container-lowest text-on-surface font-label-md text-label-md hover:bg-surface-container-high transition-colors" onclick="closeTransactionModal()" type="button">
          Batal
        </button>
<button class="px-space-lg py-3 rounded-xl bg-primary text-on-primary font-label-lg text-label-lg hover:bg-primary-container transition-transform active:scale-95 shadow-md flex items-center gap-2" onclick="saveInstantTransaction()" type="button">
<span class="material-symbols-outlined text-xl">save</span>
<span>Simpan Transaksi Kilat</span>
</button>
