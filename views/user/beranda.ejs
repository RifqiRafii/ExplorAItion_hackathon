<button class="p-2.5 rounded-xl bg-surface-container hover:bg-primary/10 text-on-surface hover:text-primary transition-all text-left flex flex-col justify-between" onclick="selectQuickSku('Minyak Kita 2L', 32000)" type="button">
<span class="font-label-md text-label-md font-bold truncate">Minyak Kita 2L</span>
<span class="font-body-sm text-body-sm text-primary font-bold mt-1">Rp 32.000</span>
</button>
<button class="p-2.5 rounded-xl bg-surface-container hover:bg-primary/10 text-on-surface hover:text-primary transition-all text-left flex flex-col justify-between" onclick="selectQuickSku('Mie Goreng Dus', 115000)" type="button">
<span class="font-label-md text-label-md font-bold truncate">Mie Grg Dus</span>
