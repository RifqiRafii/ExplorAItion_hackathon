<!-- Notification Toast Simulation -->
<div class="fixed bottom-6 right-6 z-50 bg-inverse-surface text-inverse-on-surface px-4 py-3 rounded-xl shadow-xl flex items-center gap-2 transform translate-y-24 opacity-0 transition-all duration-300" id="toast-notif">
<span class="material-symbols-outlined text-secondary text-lg">check_circle</span>
<span class="font-label-md text-label-md" id="toast-text">Aksi berhasil dilakukan</span>
</div>
</div>
<script>
  let currentDraftData = {
    name: 'Bu Siti',
    amount: 'Rp 175.000',
    items: 'Beras Ramos 5kg, Telur 1kg, Minyak Goreng Tropical 2L',
    phone: '081234981120',
    overdue: 'Lewat 2 Hari',
    tone: 'sopan'
  };

  let activePayData = {
    name: 'Bu Siti',
    amount: 175000
  };

  function openModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.classList.remove('hidden');
  }

  function closeModal(id) {
    const modal = document.getElementById(id);
    if (modal) modal.classList.add('hidden');
  }

  function openDraftModal(name, amount, items, phone, overdue) {
    currentDraftData.name = name;
    currentDraftData.amount = amount;
    currentDraftData.items = items;
    currentDraftData.phone = phone;
    currentDraftData.overdue = overdue;
    
    document.getElementById('draft-target-name').textContent = name;
    document.getElementById('draft-target-amount').textContent = amount;
    document.getElementById('draft-target-meta').textContent = items;
    
    setTone(currentDraftData.tone || 'sopan');
    openModal('modal-wa-draft');
  }

  function setTone(tone) {
    currentDraftData.tone = tone;
    
    // Reset buttons
    const buttons = document.querySelectorAll('.tone-btn');
    buttons.forEach(btn => {
      btn.className = "tone-btn py-2 px-2.5 rounded-xl font-label-md text-label-md font-semibold bg-surface-container text-on-surface text-center hover:bg-surface-container-high";
    });
    
    const activeBtn = document.getElementById('tone-btn-' + tone);
    if (activeBtn) {
      activeBtn.className = "tone-btn py-2 px-2.5 rounded-xl font-label-md text-label-md font-bold bg-primary text-on-primary shadow-sm text-center";
    }

    const preview = document.getElementById('wa-preview-text');
    const { name, amount, items } = currentDraftData;

    if (tone === 'sopan') {
      preview.textContent = `Assalamu'alaikum ${name}, semoga sehat dan berkah selalu sekeluarga 🙏\n\nMohon maaf sebelumnya mengganggu waktunya ya. Sekadar pengingat santun dari Warung Berkah terkait catatan belanja kemarin:\n- ${items}\nTotal: ${amount}.\n\nKebetulan warung mau kulakan beras dan sembako lagi ke distributor grosir. Jika ada kelonggaran rezeki, bisa dititipkan via kasir atau transfer ya. Terima kasih banyak atas kepercayaan dan kerjasamanya! 🙏`;
    } else if (tone === 'santai') {
      preview.textContent = `Halo ${name}, kabar sehat ya? 😊\n\nCuma mau infoin santai catatan kasbon di Warung Berkah nih:\n- ${items}\nTotalnya: ${amount}.\n\nKalo lagi lewat atau sempat, boleh mampir sekalian ngopi sambil selesaikan bon ya. Makasih banyak ya ${name}! 👍`;
    } else if (tone === 'qris') {
      preview.textContent = `Pemberitahuan Tagihan Belanja - Warung Berkah Jaya\n\nKepada: ${name}\nRincian Belanja: ${items}\nTotal Tagihan: ${amount}\n\nPembayaran praktis bisa langsung scan QRIS toko kami atau transfer langsung. Mohon konfirmasi jika sudah selesai ya. Terima kasih telah berbelanja di warung kelontong kami! 🙏`;
    }
  }

  function copyDraftText() {
    const text = document.getElementById('wa-preview-text').textContent;
    navigator.clipboard.writeText(text);
    showToast('Teks tagihan berhasil disalin ke clipboard!');
  }

  function sendToWhatsApp() {
    const text = encodeURIComponent(document.getElementById('wa-preview-text').textContent);
    const cleanPhone = currentDraftData.phone.replace(/[^0-9]/g, '');
    const waUrl = `https://wa.me/${cleanPhone}?text=${text}`;
    window.open(waUrl, '_blank');
    closeModal('modal-wa-draft');
    showToast(`Draf terkirim ke WhatsApp ${currentDraftData.name}`);
  }

  function openBulkReminderModal() {
    openDraftModal('Kirim Pengingat Masal (3 Kontak Kritis)', 'Rp 1.150.000', 'Bu Siti, Bu Dewi, Pak Bambang', '081234981120', 'Prioritas');
  }

  function openPaymentModal(name, amount) {
    activePayData.name = name;
    activePayData.amount = amount;
    
    document.getElementById('pay-customer-subtitle').textContent = `Pelanggan: ${name}`;
    document.getElementById('pay-remaining-amount').textContent = `Rp ${amount.toLocaleString('id-ID')}`;
    document.getElementById('pay-amount-input').value = amount;
    
    openModal('modal-catat-bayar');
  }

  function setQuickPay(val) {
    document.getElementById('pay-amount-input').value = val;
  }

  function setFullPay() {
    document.getElementById('pay-amount-input').value = activePayData.amount;
  }

  function handlePaymentSubmit(e) {
    e.preventDefault();
    const paid = document.getElementById('pay-amount-input').value;
    closeModal('modal-catat-bayar');
    showToast(`Pembayaran Rp ${Number(paid).toLocaleString('id-ID')} atas nama ${activePayData.name} berhasil dicatat.`);
  }

  function handleNewBonSubmit(e) {
    e.preventDefault();
    closeModal('modal-catat-kasbon');
    showToast('Kasbon baru berhasil disimpan ke buku utang.');
  }

  function showToast(msg) {
    const toast = document.getElementById('toast-notif');
    const toastText = document.getElementById('toast-text');
    toastText.textContent = msg;
    toast.classList.remove('translate-y-24', 'opacity-0');
    setTimeout(() => {
      toast.classList.add('translate-y-24', 'opacity-0');
    }, 3200);
  }

  function setTabFilter(status, btnElement) {
    const tabs = document.querySelectorAll('.tab-btn');
    tabs.forEach(t => {
      t.className = "tab-btn px-3 py-1.5 rounded-full font-label-md text-label-md text-on-surface-variant hover:bg-surface-container transition-all whitespace-nowrap";
    });
    btnElement.className = "tab-btn px-3 py-1.5 rounded-full font-label-md text-label-md font-bold bg-primary text-on-primary transition-all whitespace-nowrap";

    filterCards(status);
  }

  function filterByStatus(status) {
    const buttons = document.querySelectorAll('.tab-btn');
    buttons.forEach(b => {
      if (b.textContent.toLowerCase().includes(status)) {
        b.click();
      }
    });
  }

  function filterCards(status) {
    const cards = document.querySelectorAll('.bon-card');
    let visible = 0;
    cards.forEach(card => {
      if (status === 'all' || card.getAttribute('data-status') === status) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });
    document.getElementById('filtered-count').textContent = `Menampilkan ${visible} bon kasbon`;
  }

  function searchCustomer(query) {
    const q = query.toLowerCase().trim();
    const cards = document.querySelectorAll('.bon-card');
    let visible = 0;
    cards.forEach(card => {
      const name = card.getAttribute('data-name') || '';
      if (name.includes(q)) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });
    document.getElementById('filtered-count').textContent = `Menampilkan ${visible} bon cocok`;
  }
</script></main></div></body></html>