<span class="material-symbols-outlined text-primary-fixed" id="toastIcon">check_circle</span>
<span class="font-body-md text-body-md" id="toastMessage">Teks pesanan berhasil disalin!</span>
</div>
</div>
<script>
  function togglePODrawer() {
    const backdrop = document.getElementById('poDrawerBackdrop');
    const content = document.getElementById('poDrawerContent');
    const isClosed = backdrop.classList.contains('pointer-events-none');
    
    if (isClosed) {
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');
      content.classList.remove('translate-x-full');
      content.classList.add('translate-x-0');
    } else {
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100');
      content.classList.add('translate-x-full');
      content.classList.remove('translate-x-0');
    }
  }

  function adjustQty(elementId, change) {
    const el = document.getElementById(elementId);
    let val = parseInt(el.innerText, 10);
    val = Math.max(1, val + change);
    el.innerText = val;
    showToast('Kuantitas diperbarui: ' + val);
  }

  function showToast(msg) {
    const toast = document.getElementById('toastNotification');
    const msgEl = document.getElementById('toastMessage');
    msgEl.innerText = msg;
    toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');
    
    setTimeout(() => {
      toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }, 2800);
  }

  function copySupplierPO(supplier, detail) {
    const textToCopy = `*PO Grosir Warung Berkah*\nKepada: ${supplier}\n${detail}\nMohon info ketersediaan stok & pengiriman. Terima kasih.`;
    navigator.clipboard.writeText(textToCopy).then(() => {
      showToast('Draf pesanan ' + supplier + ' berhasil disalin!');
    }).catch(() => {
      showToast('Draf disalin ke clipboard');
    });
  }

  function sendWhatsAppPO(supplier, message) {
    showToast('Membuka WhatsApp untuk ' + supplier + '...');
    const encoded = encodeURIComponent(message);
    window.open(`https://wa.me/?text=${encoded}`, '_blank');
  }

  function triggerQuickWhatsApp() {
    sendWhatsAppPO('Semua Agen Grosir', 'Halo Agen Grosir Sembako, draf PO otomatis Warung Berkah untuk akhir pekan telah disiapkan. Total order Rp 1.820.000. Mohon proses order.');
  }

  function sendDirectWhatsAppModal() {
    togglePODrawer();
    sendWhatsAppPO('Agen Beras Sumber Makmur', 'Halo Agen Beras Sumber Makmur, konfirmasi PO: Beras Ramos 5kg (10 sak) & Beras Pandan Wangi 5kg (5 sak) = Rp 1.055.000. Kirim besok pagi pkl 08.00 ya.');
  }

  function addQuickRestock(item, qty, supplier) {
    showToast(`Ditambahkan ke PO: ${qty}x ${item} (${supplier})`);
  }

  function openBundlingModal(item) {
    showToast(`Membuat bundling otomatis untuk ${item} diskon 15%`);
  }

  function activateClearanceSale() {
    const btn = document.getElementById('btnClearance');
    btn.innerHTML = '<span class="material-symbols-outlined text-base">check</span> Diskon Aktif di Kasir POS';
    btn.classList.remove('bg-tertiary');
    btn.classList.add('bg-primary-container', 'text-on-primary-container');
    showToast('Diskon cuci gudang 10% berhasil disinkronkan ke kasir.');
  }
</script></main></div></body></html>